node_modules/

# Build artifacts — regenerated by `bun run build` (runs automatically before
# `bun run dev` / `bun run deploy`). Source lives in src/, public/index.html and the macterm checkout.
public/docs/
public/tokens.css
public/components/
public/sitemap.xml
public/robots.txt
public/img/
public/changelog.html

# Written by `node lastmod.mjs` and `node releases.mjs` on the host for an
# image build, which has no git history and no token. A checkout reads git and
# GitHub directly.
generated/

# The checkout of macterm/macterm that the site renders (content.mjs).
macterm/

# Copied from macterm/assets by copy-assets.mjs.
public/assets/
